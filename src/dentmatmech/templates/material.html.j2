{% extends "_base.html.j2" %}
{% from "_evidence.html.j2" import evidence, descriptor with context %}
{% set root = "../../" %}
{% block title %}{{ m.name }} · dentmatmech{% endblock %}
{% block body %}
<h1>{{ m.name }}</h1>
<div class="pills">
  {% if m.material_term and m.material_term.term %}
  <a class="pill accent" href="{{ m.material_term.term.id|term_url }}">{{ m.material_term.term.id }} · {{ m.material_term.term.label }}</a>
  {% endif %}
  <span class="pill">{{ titles.MaterialCategoryEnum.get(m.category, m.category) }}</span>
  <span class="pill status-{{ m.curation_status or 'STUB' }}">{{ titles.CurationStatusEnum.get(m.curation_status or 'STUB') }}</span>
  {% for rs in m.regulatory_status or [] if rs.agency == 'FDA' %}
  <span class="pill fda">FDA {{ titles.DeviceClassEnum.get(rs.device_class, rs.device_class or '') }}{% if rs.regulation_number %} · 21 CFR {{ rs.regulation_number }}{% endif %}</span>
  {% endfor %}
</div>
{% if m.description %}<p class="lede">{{ m.description }}</p>{% endif %}

<div class="toc">
  <a href="#hierarchy">Hierarchy</a>
  <a href="#composition">Composition</a>
  <a href="#properties">Properties</a>
  <a href="#uses">Clinical uses</a>
  <a href="#performance">Performance</a>
  <a href="#safety">Safety</a>
  <a href="#regulatory">Regulatory status</a>
  <a href="#products">Products</a>
  <a href="#standards">Standards</a>
</div>

{% if (m.curation_status or 'STUB') == 'STUB' %}
<div class="disclaimer">This entry is a stub seeded from the ontology. Only the name, definition, term, and hierarchy are populated so far.</div>
{% endif %}

<h2 id="hierarchy">Hierarchy</h2>
<dl class="kv">
  <dt>Parent materials</dt>
  <dd>{% for p in m.parents or [] %}<a href="{{ p|slugify }}.html">{{ p }}</a>{{ ", " if not loop.last }}{% else %}<span class="empty">none (top of the tree)</span>{% endfor %}</dd>
  <dt>Child materials</dt>
  <dd>{% for c in children %}<a href="{{ c|slugify }}.html">{{ c }}</a>{{ ", " if not loop.last }}{% else %}<span class="empty">none</span>{% endfor %}</dd>
  {% if m.synonyms %}<dt>Synonyms</dt><dd>{{ m.synonyms|join(", ") }}</dd>{% endif %}
  {% if m.setting_mechanisms %}<dt>Setting</dt><dd>{% for s in m.setting_mechanisms %}<span class="pill">{{ titles.SettingMechanismEnum.get(s, s) }}</span> {% endfor %}</dd>{% endif %}
  {% if m.mappings %}<dt>Mappings</dt><dd>{% for x in m.mappings %}<a class="pill" href="{{ x.id|term_url }}">{{ x.id }}</a> {{ x.label }} <span class="muted">({{ x.predicate|enum_title|lower }})</span><br>{% endfor %}</dd>{% endif %}
</dl>

<h2 id="composition">Composition</h2>
{% if m.composition %}
<table><thead><tr><th>Component</th><th>Role</th><th>Chemical</th><th>Proportion</th><th>Notes</th></tr></thead><tbody>
{% for c in m.composition %}
<tr><td>{{ c.name }}</td><td>{{ titles.ComponentRoleEnum.get(c.role, c.role or '') }}</td><td>{{ descriptor(c.chemical) }}</td><td>{{ c.proportion or '' }}</td><td>{{ c.description or '' }}{{ evidence(c.evidence) }}</td></tr>
{% endfor %}
</tbody></table>
{% else %}<p class="empty">Not yet curated.</p>{% endif %}

<h2 id="properties">Properties</h2>
{% if m.properties %}
<table><thead><tr><th>Property</th><th>Value</th><th>Method / conditions</th><th>Notes</th></tr></thead><tbody>
{% for p in m.properties %}
<tr><td>{{ p.name or titles.PropertyTypeEnum.get(p.property_type, p.property_type) }}<br><span class="muted">{{ titles.PropertyTypeEnum.get(p.property_type, p.property_type) }}</span>{% if p.quality_term %}<br>{{ descriptor(p.quality_term) }}{% endif %}</td>
<td>{{ p.value or '' }} {{ p.unit or '' }}</td><td>{{ p.test_method or '' }}{% if p.conditions %}<br><span class="muted">{{ p.conditions }}</span>{% endif %}</td><td>{{ p.description or '' }}{{ evidence(p.evidence) }}</td></tr>
{% endfor %}
</tbody></table>
{% else %}<p class="empty">Not yet curated.</p>{% endif %}

<h2 id="uses">Clinical uses</h2>
{% for u in m.clinical_uses or [] %}
<div class="card">
  <h3>{{ u.name }} <span class="pill">{{ titles.ClinicalUseContextEnum.get(u.use_context, u.use_context) }}</span></h3>
  {% if u.description %}<p>{{ u.description }}</p>{% endif %}
  <dl class="kv">
    {% if u.procedure %}<dt>Procedure</dt><dd>{{ descriptor(u.procedure) }}</dd>{% endif %}
    {% if u.anatomical_site %}<dt>Site</dt><dd>{{ descriptor(u.anatomical_site) }}</dd>{% endif %}
    {% if u.indications %}<dt>Indications</dt><dd><ul class="plain">{% for i in u.indications %}<li>{{ i }}</li>{% endfor %}</ul></dd>{% endif %}
    {% if u.contraindications %}<dt>Contraindications</dt><dd><ul class="plain">{% for i in u.contraindications %}<li>{{ i }}</li>{% endfor %}</ul></dd>{% endif %}
  </dl>
  {{ evidence(u.evidence) }}
</div>
{% else %}<p class="empty">Not yet curated.</p>{% endfor %}

<h2 id="performance">Clinical performance</h2>
{% if m.clinical_performance %}
<table><thead><tr><th>Measure</th><th>Value</th><th>Follow-up</th><th>Population / comparator</th><th>Notes</th></tr></thead><tbody>
{% for p in m.clinical_performance %}
<tr><td>{{ p.name }}<br><span class="muted">{{ titles.PerformanceMeasureEnum.get(p.measure_type, p.measure_type) }}</span></td><td>{{ p.value or '' }} {{ p.unit or '' }}</td><td>{{ p.follow_up_years ~ ' y' if p.follow_up_years else '' }}</td><td>{{ p.population or '' }}{% if p.comparator %}<br><span class="muted">vs {{ p.comparator }}</span>{% endif %}</td><td>{{ p.description or '' }}{{ evidence(p.evidence) }}</td></tr>
{% endfor %}
</tbody></table>
{% else %}<p class="empty">Not yet curated.</p>{% endif %}

<h2 id="safety">Adverse effects and safety</h2>
{% for a in m.adverse_effects or [] %}
<div class="card">
  <h3>{{ a.name }} <span class="pill warn">{{ titles.AdverseEffectCategoryEnum.get(a.effect_category, a.effect_category) }}</span></h3>
  {% if a.description %}<p>{{ a.description }}</p>{% endif %}
  <dl class="kv">
    {% if a.effect_term %}<dt>Term</dt><dd>{{ descriptor(a.effect_term) }}</dd>{% endif %}
    {% if a.frequency %}<dt>Frequency</dt><dd>{{ a.frequency }}</dd>{% endif %}
  </dl>
  {{ evidence(a.evidence) }}
</div>
{% else %}<p class="empty">Not yet curated.</p>{% endfor %}

<h2 id="regulatory">Regulatory status</h2>
{% for rs in m.regulatory_status or [] %}
<div class="card {{ 'fda' if rs.agency == 'FDA' }}">
  <h3>{{ titles.RegulatoryAgencyEnum.get(rs.agency, rs.agency) }}{% if rs.jurisdiction %} · {{ rs.jurisdiction }}{% endif %}
    <span class="pill fda">{{ titles.RegulatoryStatusEnum.get(rs.status, rs.status) }}</span></h3>
  <dl class="kv">
    {% if rs.regulation_number %}<dt>Regulation</dt><dd>{% if rs.agency == 'FDA' %}<a href="{{ rs.regulation_number|ecfr }}">21 CFR {{ rs.regulation_number }}</a>{% else %}{{ rs.regulation_number }}{% endif %}{% if rs.regulation_title %} · {{ rs.regulation_title }}{% endif %}</dd>{% endif %}
    {% if rs.device_class %}<dt>Device class</dt><dd>{{ titles.DeviceClassEnum.get(rs.device_class, rs.device_class) }}</dd>{% endif %}
    {% if rs.product_codes %}<dt>Product codes</dt><dd>{% for c in rs.product_codes %}<a class="pill" href="{{ c|fda_pcd }}">{{ c }}</a> {% endfor %}</dd>{% endif %}
    {% if rs.pathways %}<dt>Pathways</dt><dd>{% for p in rs.pathways %}<span class="pill">{{ titles.RegulatoryPathwayEnum.get(p, p) }}</span> {% endfor %}</dd>{% endif %}
    {% if rs.special_controls %}<dt>Special controls</dt><dd><ul class="plain">{% for s in rs.special_controls %}<li>{{ s }}</li>{% endfor %}</ul></dd>{% endif %}
    {% if rs.effective_date %}<dt>Effective</dt><dd>{{ rs.effective_date }}</dd>{% endif %}
    {% if rs.source_url %}<dt>Source</dt><dd><a href="{{ rs.source_url }}">{{ rs.source_url }}</a></dd>{% endif %}
  </dl>
  {% if rs.identification %}<blockquote>{{ rs.identification }}</blockquote>{% endif %}
  {% if rs.approved_uses %}
  <h3>Permitted uses</h3>
  <ul class="plain">
    {% for u in rs.approved_uses %}<li><strong>{{ u.name }}</strong>{% if u.use_context %} <span class="pill">{{ titles.ClinicalUseContextEnum.get(u.use_context, u.use_context) }}</span>{% endif %}{% if u.description %} · {{ u.description }}{% endif %}{% if u.procedure %} · {{ descriptor(u.procedure) }}{% endif %}{% if u.anatomical_site %} · {{ descriptor(u.anatomical_site) }}{% endif %}{{ evidence(u.evidence) }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if rs.restrictions %}<h3>Restrictions</h3><ul class="plain">{% for r in rs.restrictions %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
  {% if rs.notes %}<p class="muted">{{ rs.notes }}</p>{% endif %}
  {{ evidence(rs.evidence) }}
</div>
{% else %}<p class="empty">No regulatory status curated yet.</p>{% endfor %}

<h2 id="products">Commercial products</h2>
{% for p in m.products or [] %}
<div class="card">
  <h3>{{ p.name }}{% if p.manufacturer %} <span class="muted">· {{ p.manufacturer }}</span>{% endif %}</h3>
  {% if p.description %}<p>{{ p.description }}</p>{% endif %}
  {% if p.submissions %}
  <table><thead><tr><th>Agency</th><th>Submission</th><th>Pathway</th><th>Decision</th><th>Date</th><th>Code / regulation</th><th>Indications for use</th></tr></thead><tbody>
  {% for s in p.submissions %}
  <tr><td>{{ s.agency }}</td><td>{% set su = s.submission_number|submission_url %}{% if su %}<a href="{{ su }}">{{ s.submission_number }}</a>{% else %}{{ s.submission_number or '' }}{% endif %}</td>
  <td>{{ titles.RegulatoryPathwayEnum.get(s.pathway, s.pathway or '') }}</td><td>{{ titles.RegulatoryStatusEnum.get(s.decision, s.decision or '') }}</td><td>{{ s.decision_date or '' }}</td>
  <td>{{ s.product_code or '' }}{% if s.regulation_number %} · {{ s.regulation_number }}{% endif %}</td><td>{{ s.indications_for_use or '' }}{% if s.source_url %}<br><a href="{{ s.source_url }}">source</a>{% endif %}{{ evidence(s.evidence) }}</td></tr>
  {% endfor %}
  </tbody></table>
  {% endif %}
  {% if p.see_also %}<p class="muted">{% for u in p.see_also %}<a href="{{ u }}">{{ u }}</a> {% endfor %}</p>{% endif %}
</div>
{% else %}<p class="empty">No products curated yet.</p>{% endfor %}

<h2 id="standards">Standards</h2>
{% if m.standards %}
<ul class="plain">{% for s in m.standards %}<li><strong>{{ s.identifier }}</strong>{% if s.title %} · {{ s.title }}{% endif %}{% if s.organization %} <span class="muted">({{ s.organization }})</span>{% endif %}{% if s.url %} · <a href="{{ s.url }}">link</a>{% endif %}</li>{% endfor %}</ul>
{% else %}<p class="empty">Not yet curated.</p>{% endif %}

{% if m.see_also %}<h2>See also</h2><ul class="plain">{% for u in m.see_also %}<li><a href="{{ u }}">{{ u }}</a></li>{% endfor %}</ul>{% endif %}
{% if m.notes %}<h2>Curator notes</h2>{{ m.notes|md|safe }}{% endif %}
<p class="muted" style="margin-top:2rem">Source file: <a href="https://github.com/caufieldjh/dentmatmech/blob/main/kb/materials/{{ slug }}.yaml">kb/materials/{{ slug }}.yaml</a></p>
{% endblock %}
