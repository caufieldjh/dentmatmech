{% macro evidence(items) -%}
{% if items %}
<details class="evidence"><summary>{{ items|length }} evidence item{{ 's' if items|length != 1 }}</summary>
{% for e in items %}
<div class="ev">
  <div class="meta">
    {% set u = e.reference|reference_url %}
    {% if u %}<a href="{{ u }}">{{ e.reference }}</a>{% else %}{{ e.reference }}{% endif %}
    {% if e.reference_title %} · {{ e.reference_title }}{% endif %}
    · <span class="pill">{{ titles.EvidenceItemSupportEnum.get(e.supports, e.supports) }}</span>
    {% if e.evidence_source %}<span class="pill">{{ titles.EvidenceSourceEnum.get(e.evidence_source, e.evidence_source) }}</span>{% endif %}
  </div>
  {% if e.snippet %}<div class="snippet">“{{ e.snippet }}”</div>{% endif %}
  {% if e.explanation %}<div>{{ e.explanation }}</div>{% endif %}
</div>
{% endfor %}
</details>
{% endif %}
{%- endmacro %}

{% macro descriptor(d) -%}
{% if d %}{{ d.preferred_term or (d.term.label if d.term) }}{% if d.term %} <a class="pill" href="{{ d.term.id|term_url }}">{{ d.term.id }}</a>{% endif %}{% endif %}
{%- endmacro %}
