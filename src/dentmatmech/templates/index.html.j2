{% extends "_base.html.j2" %}
{% set root = "../../" %}
{% block title %}Dental materials · dentmatmech{% endblock %}
{% macro node(name) -%}
<li><a href="{{ name|slugify }}.html">{{ name }}</a>
  <span class="pill status-{{ kb[name].curation_status or 'STUB' }}">{{ titles.CurationStatusEnum.get(kb[name].curation_status or 'STUB') }}</span>
  {% for rs in kb[name].regulatory_status or [] if rs.agency == 'FDA' %}<span class="pill fda">FDA {{ titles.DeviceClassEnum.get(rs.device_class, rs.device_class or '') }}</span>{% endfor %}
  {% if children.get(name) %}<ul>{% for c in children[name]|sort %}{{ node(c) }}{% endfor %}</ul>{% endif %}
</li>
{%- endmacro %}
{% block body %}
<h1>Dental Materials Knowledge Base</h1>
<p class="lede">One entry per material in the <a href="https://obofoundry.org/ontology/ohd.html">Oral Health and Disease Ontology</a> branch under
<a href="https://www.ebi.ac.uk/ols4/ontologies/ohd/classes?obo_id=OHD:0000000">dental restoration material</a>: composition, properties, clinical use, performance, safety, and regulatory status.</p>
<div class="grid">
  <div class="card"><div class="stat">{{ kb|length }}</div>materials</div>
  <div class="card"><div class="stat">{{ kb|length - n_stub }}</div>with curated content</div>
  <div class="card"><div class="stat">{{ n_fda }}</div>with FDA status recorded</div>
</div>
<p><a href="../../app/index.html">Open the faceted browser →</a></p>

<h2>Hierarchy</h2>
<div class="tree"><ul>{% for r in roots %}{{ node(r) }}{% endfor %}</ul></div>

<h2>By category</h2>
{% for cat, items in by_cat.items() %}
<h3>{{ titles.MaterialCategoryEnum.get(cat, cat) }} <span class="muted">({{ items|length }})</span></h3>
<p>{% for m in items|sort(attribute='name') %}<a href="{{ m.name|slugify }}.html">{{ m.name }}</a>{{ " · " if not loop.last }}{% endfor %}</p>
{% endfor %}
{% endblock %}
